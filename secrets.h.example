/*
  Local Wi-Fi credentials for rf_bench2.

  Copy this file to secrets.h and fill in your own values. secrets.h is
  listed in .gitignore and must not be committed.

      cp secrets.h.example secrets.h

  rf_bench2.ino includes secrets.h when it exists and falls back to the
  placeholder values below otherwise, so a fresh clone still compiles.
*/

#ifndef SECRETS_H
#define SECRETS_H

#define RF_BENCH2_HAS_SECRETS

const char* WIFI_SSID     = "YOUR_SSID";
const char* WIFI_PASSWORD = "YOUR_PASSWORD";
const char* HOSTNAME      = "rfbench";

#endif